# ==============================================================================
# EduGraphic Platform - Environment Variables Template
# Copy this file to .env and provide your production/staging values.
# NEVER commit actual API keys or secrets to version control.
# ==============================================================================

# Server Environment Configuration
NODE_ENV=production
PORT=3000

# Google Gemini AI API Key (Required for server-side diagram & educational analysis)
# Keep strictly on the server; never expose in frontend client code.
GEMINI_API_KEY=

# Optional Google API Key fallback
GOOGLE_API_KEY=

# Web Application Base URL
# In Web mode: points to your hosted domain (e.g., https://edugraphic.app)
# In Capacitor Android/iOS mode: can point to your backend API server
VITE_API_BASE_URL=

# Optional: Custom Firebase Configuration (if deploying to your own Firebase Project)
# Leave empty to use default applet configuration from firebase-applet-config.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
